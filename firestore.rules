rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: auto-generated or uid
// Fields:
//   - name: string (required, 1-100 chars)
//   - email: string (required, email format)
//   - phone: string (required, 10-15 chars)
//   - role: string (required, in ['SUPER_ADMIN', 'BRANCH_ADMIN', 'STORE_MANAGER', 'BILLING_STAFF', 'DESIGNER'])
//   - permissions: list (required, strings)
//   - branchId: string (optional)
//   - isActive: bool (required)
//
// Collection: customers
// Document ID: auto-generated or cust_*
// Fields:
//   - name: string (required, 1-100 chars)
//   - mobile: string (required, 10-15 chars)
//   - customerType: string (required, in ['INDIVIDUAL', 'STUDIO_PARTNER', 'CORPORATE', 'VIP'])
//   - outstandingBalance: number (required)
//   - loyaltyPoints: number (required)
//
// Collection: products
// Document ID: auto-generated or prod_*
// Fields:
//   - sku: string (required)
//   - name: string (required)
//   - sellingPrice: number (required, >= 0)
//   - gstRate: number (required, in [0, 5, 12, 18, 28])
//   - stock: number (required)
//
// Collection: invoices
// Document ID: auto-generated or inv_*
// Fields:
//   - invoiceNumber: string (required, immutable)
//   - customerId: string (required)
//   - customerName: string (required)
//   - grandTotal: number (required, >= 0)
//   - paidAmount: number (required, >= 0)
//   - balanceDue: number (required)
//   - paymentStatus: string (required, in ['PAID', 'PARTIAL', 'UNPAID'])
//   - createdAt: string or timestamp (immutable)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserRole() == 'SUPER_ADMIN' ||
        getUserRole() == 'BRANCH_ADMIN' ||
        request.auth.token.admin == true
      );
    }

    function isBillingStaff() {
      return isAuthenticated() && (
        isAdmin() ||
        getUserRole() == 'BILLING_STAFF' ||
        getUserRole() == 'STORE_MANAGER'
      );
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isValidPositive(val) {
      return val is number && val >= 0;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 1. Users collection (Protected PII and role escalation prevention)
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create, update: if isAuthenticated() && isAdmin();
      allow delete: if isAuthenticated() && isAdmin() && !isOwner(userId);
    }

    // 2. Business Settings & Branches
    match /business_settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    match /branches/{branchId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // 3. Customers
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isBillingStaff();
      allow update: if isAuthenticated() && isBillingStaff();
      allow delete: if isAuthenticated() && isAdmin();
    }

    match /customer_ledgers/{ledgerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isBillingStaff();
      allow update, delete: if isAuthenticated() && isAdmin();
    }

    // 4. Products & Inventory Transactions
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (isAdmin() || getUserRole() == 'STORE_MANAGER');
      allow delete: if isAuthenticated() && isAdmin();
    }

    match /inventory_transactions/{txId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isBillingStaff();
      allow update, delete: if false; // Inventory audit trail is strictly immutable
    }

    // 5. Photo Print Rates & Frame Mouldings
    match /photo_print_prices/{priceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    match /frame_types/{typeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    match /frame_prices/{priceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // 6. Invoices & Payments (Financial documents)
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isBillingStaff();
      // Only allow cancellation or payment status update, never allow altering financial totals
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isBillingStaff() && areImmutableFieldsUnchanged(['invoiceNumber', 'subtotal', 'totalTax', 'grandTotal', 'items']))
      );
      allow delete: if false; // Invoices are permanent accounting records
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isBillingStaff();
      allow update, delete: if false; // Payments cannot be modified once recorded
    }

    // 7. Orders & Studio Production
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isBillingStaff();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && isAdmin();
    }

    // 8. Sync Operations & Audit Logs
    match /sync_operations/{opId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isAdmin();
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Audit logs are strictly append-only
    }

    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Default deny all unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
